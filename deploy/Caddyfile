# 观物的静态站点。setup-server.sh 会把 guanwu.example 换成真实域名，写到 /etc/caddy/Caddyfile。
# Caddy 自动申请和续期 HTTPS 证书（Let's Encrypt）。

guanwu.example {
	root * /srv/guanwu

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# 带哈希的构建产物永不变，缓存一年；其余文件名固定（页面、模型、wasm、字体），
	# 每次都带 ETag 问一下，没变就是 304，不重新下载。
	# defer：只加在真正发出去的文件上，404 不带缓存头
	@hashed path /assets/*
	header @hashed {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}
	@fixed not path /assets/*
	header @fixed {
		Cache-Control "no-cache"
		defer
	}

	# 预先压好的 .br/.gz 直接发（scripts/compress.mjs 生成）
	file_server {
		precompressed br gzip
	}
}

www.guanwu.example {
	redir https://guanwu.example{uri} permanent
}
